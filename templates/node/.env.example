HUB_URL=https://hub.example.com
HUB_AGENT_TOKEN=replace-with-site-agent-token
# Relative paths are resolved from the process working directory.
HUB_RUNTIME_DIR=./runtime
HUB_STATE_DIR=./runtime
# Optional, local-only codebase directory; on-demand backups work with schedules off.
# HUB_BACKUP_DIR=/srv/my-automation
# HUB_BACKUP_SOURCE=/srv/my-automation
# HUB_BACKUP_MAX_BYTES=1073741824
# HUB_BACKUP_TIMEOUT_MS=300000
# HUB_BACKUP_TEMP=/var/tmp

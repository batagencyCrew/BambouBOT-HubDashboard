# Set these in the process environment (this file is NOT auto-loaded).
HUB_URL=https://hub.example.com
HUB_AGENT_TOKEN=replace-with-site-scoped-agent-token
HUB_RUNTIME_DIR=./runtime
HUB_STATE_DIR=./runtime/state
# Optional first-enrollment seeds; existing runtime/config.json and proxies.txt win.
HUB_LOCAL_CONFIG=./localconfig.json
HUB_LOCAL_PROXIES=./localproxies.txt
# Optional LOCAL source directory. Empty disables archive capability, not workers.
HUB_BACKUP_DIR=
# Must already exist and be outside HUB_BACKUP_DIR. Defaults to OS temp directory.
HUB_BACKUP_TEMP_DIR=/tmp
# Limits BOTH compressed archive and total uncompressed regular-file bytes.
HUB_BACKUP_MAX_BYTES=1073741824

# Compose only. Copy to .env, chmod 600, then replace all three values.
HUB_DOMAIN=hub.example.com
ACME_EMAIL=operator@example.com
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(36))"
HUB_ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
# Backup quotas: 1 GiB/file, 10 GiB total staging, 7-day completed local cache.
# HUB_BACKUP_MAX_UPLOAD_BYTES=1073741824
# HUB_BACKUP_MAX_STORAGE_BYTES=10737418240
# HUB_BACKUP_RETENTION_DAYS=7
# HUB_BACKUP_TRANSFER_TIMEOUT_SECONDS=3600
# Telemetry storage admission, not AI/provider rate limits. Batch AI reports.
# Budget receipts for all chat events + AI batches across the retention window.
# HUB_TELEMETRY_HISTORY_SITE=9000
# HUB_TELEMETRY_HISTORY_GLOBAL=90000
# HUB_TELEMETRY_RECEIPTS_SITE=20000
# HUB_TELEMETRY_RECEIPTS_GLOBAL=200000
# HUB_TELEMETRY_RETENTION_DAYS=7

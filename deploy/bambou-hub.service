[Unit]
Description=Bambou hub v2 (dashboard, admin API, agent API, bots)
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=simple
User=bambou
Group=bambou
WorkingDirectory=/opt/bambou-hub
EnvironmentFile=/etc/bambou-hub.env
ExecStart=/opt/bambou-hub/.venv/bin/uvicorn hub.main:app --host 127.0.0.1 --port 8000 --workers 1 --proxy-headers --forwarded-allow-ips 127.0.0.1
# One process: the WebSocket registry, background tasks and in-process command
# push assume a single worker. Vertically scale the hub before adding workers.
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
StateDirectory=bambou-hub
StateDirectoryMode=0700
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/bambou-hub
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
UMask=0077
StandardOutput=journal
StandardError=journal
SyslogIdentifier=bambou-hub

[Install]
WantedBy=multi-user.target

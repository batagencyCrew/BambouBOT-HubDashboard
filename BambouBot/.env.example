# -----------------------------------------------------------------------------
# BambouBot — one .env for both bots. Copy it:  cp .env.example .env && chmod 600 .env
# Real environment variables always win over this file.
# A platform starts only when its token is set (or when chosen with --only).
# -----------------------------------------------------------------------------

# --- BambouAI (required) ------------------------------------------------------
# The studio login key (the one used to open the dashboard).
BAMBOU_LOGIN_KEY=
# BAMBOU_BASE_URL=https://bambouaibot.com

# --- Discord ------------------------------------------------------------------
# Bot token — Developer Portal > your app > Bot > Reset Token.
DISCORD_TOKEN=
# Your Discord user id — right-click yourself (Developer Mode on) > Copy User ID.
DISCORD_OWNER_ID=
# Optional: register slash commands instantly in one server instead of globally.
# DISCORD_GUILD_ID=

# --- Telegram -----------------------------------------------------------------
# Bot token from @BotFather (not the Discord token).
TELEGRAM_TOKEN=
# Your numeric Telegram user id (send /whoami to the bot to see it).
TELEGRAM_OWNER_ID=
# Long-poll duration in seconds (1-50).
# TELEGRAM_POLL_TIMEOUT=30

# --- GetMySocial (optional — only /gms needs it) --------------------------------
# Full Cookie header of a logged-in dashboard session — see docs/GETTING_COOKIE.md.
GMS_COOKIE=
# Optional team scope (blank = personal context).
GMS_TEAM_ID=
# GMS_BASE_URL=https://getmysocial.com
# GMS_MIN_INTERVAL_MS=350
# GMS_CACHE_TTL_MS=30000

# --- Storage ------------------------------------------------------------------
# Owners + approved users of BOTH platforms (scoped as discord:<id> / telegram:<id>).
# Relative paths resolve against this folder.
# ACCESS_FILE=./data/access.json

# --- Live smoke test only (npm run smoke) ----------------------------------------
# BAMBOU_ASSISTANT_KEY=
